# ──────────────────────────────────────────────
# Frontend Environment Variables (.env.example)
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#
# VITE_API_URL (REQUIRED in production)
#   The full URL of your deployed Django backend API.
#   Examples:
#     https://your-backend.onrender.com/api/
#     https://api.yourdomain.com/api/
#   In development, this defaults to http://127.0.0.1:8000/api/
VITE_API_URL=https://your-backend-url.onrender.com/api/

# VITE_BASE_PATH (optional)
#   The base path for GitHub Pages deployment.
#   Must match your GitHub repo name with leading/trailing slashes.
#   Default: /expenses-/
# VITE_BASE_PATH=/expenses-/
